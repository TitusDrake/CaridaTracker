{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Frontend (Expo)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["start"],
      "console": "integratedTerminal"
    },
    {
      "name": "Run Tests (Frontend)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["test"],
      "console": "integratedTerminal"
    },
    {
      "name": "Run Tests: Watch (Frontend)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "test:watch"],
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "Start All (Frontend + Backend)",
      "configurations": [],
      "preLaunchTask": "Start All (Frontend + Backend)",
      "stopAll": true
    }
  ]
}
